{
  "manifest_version": 3,
  "name": "SPIRIT Browser",
  "version": "0.2.0",
  "description": "Connect your existing Chrome tabs to the local SPIRIT Computer Use engine.",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SPIRIT Browser"
  },
  "key": ""
}
